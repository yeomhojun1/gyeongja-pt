# 백엔드 설정 예시 — 복사해서 .env 로 쓰세요
PORT=4005

# Google Gemini API 키. 설정하지 않으면 AI 기능 3종(경제 챗봇·뉴스 해설·자유 주제 시각 비교)은
# 503 과 한국어 안내를 반환합니다. (헬스체크·검증·투자권유 거절·404 등 나머지 경로는 정상 동작)
GEMINI_API_KEY=

# CORS 허용 origin (쉼표 구분). 미설정 시 localhost/127.0.0.1 의 5173,5174,4173 허용
# ALLOWED_ORIGINS=http://localhost:5174

# AI 호출 경로 3종의 IP당 분당 허용 횟수 (기본 10, 0 이면 제한 없음). 초과 시 429
# RATE_LIMIT_PER_MIN=10

# 요청 본문 크기 상한
JSON_LIMIT=1mb
